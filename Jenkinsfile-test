pipeline {
    agent any
    stages {
        stage('test') {
            steps {
                script {
                    echo 'testing the application...'
                }
            }
        }

        stage('build') {
            steps {
                script {
                    echo 'building the application...'
                    echo "Executing build for branch ${BRANCH_NAME}"
                }
            }
        }

        stage('deploy') {
            steps {
                script {
                    echo 'deploying the application...'
                    def dockerCMD = 'docker run -p 3000:80 -d mahtazare/demo-app:2.0'
                    sshagent(['ec2-server-key']) {
                        sh "ssh -o StrictHostCheckingHost=no ec2-user@56.112.80.104 ${dockerCMD}"      
                   }
                }   
            }
        }
    }

}
