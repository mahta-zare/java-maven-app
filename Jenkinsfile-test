pipeline {
    agent any
    stages {
        stage('test') {
            steps {
                script {
                    echo 'testing the application...'
                }
            }
        }

        stage('build') {
            when {
                expression {
                    BRANCH_NAME == 'jenkins-jobs'
                }
            }
            steps {
                script {
                    echo 'building the application...'
                    echo "Executing build for branch ${BRANCH_NAME}"
                }
            }
        }

        stage('deploy') {
            when {
                expression {
                    BRANCH_NAME == 'jenkins-jobs'
                }
            }
            steps {
                script {
                    echo 'deploying the application...'
                    echo "Deploying to branch ${BRANCH_NAME}"
                }   
            }
        }
    }

}
