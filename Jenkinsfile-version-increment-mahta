#!/usr/bin/env groovy

pipeline {
  agent any

  tools {
    maven 'maven-3.9'
  }

  stages {
    stage("build app") {
      steps {
        script {
          echo "building application..."
          sh 'mvn clean package'
        }
      }
    }
    stage("increment version") {
      steps {
        script {
          echo "incrementing application version..."
          sh "mvn build-helper:parse-version versions:set \
              -DnewVersion=\\\${parsedVersion.majorVersion}.\\\${parsedVersion.minorVersion}.\\\${parsedVersion.nextIncrementalVersion} \
              versions:commit"
          def matcher = readFile('pom.xml') =~ '<version>(.+)</version>'
          def version = matcher[0][1]
          env.IMAGE_NAME = "$version-$BUILD_NUMBER"
        }
      }
    }
    stage("build image") {
      steps {
        script {
          echo "building docker image..."
          withCredentials([usernamePassword(credentialsId: 'docker-hub-repo', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                        sh "docker build -t mahtazare/demo_app:$IMAGE_NAME ."
                        sh "echo $PASS | docker login -u $USER --password-stdin"
                        sh "docker push mahtazare/demo_app:$IMAGE_NAME"
                    }
        }
      }
    }
      stage("deploy app") {
        steps {
          script {
            echo "deploying application on EC2"
          }
        }
      }
    stage("commit version update") {
      steps {
        script {
          withCredentials([usernamePassword(credentialsId: 'github-PAT', usernameVariable: 'USER', passwordVariable: 'TOKEN')]) {
            sh "git remote set-url origin https://${USER}:${TOKEN}@github.com/mahta-zare/java-maven-app.git"
            sh 'git add .'
            sh 'git commit -m "verison bump"'
            sh 'git push origin HEAD:jenkins-jobs'
          }
        }
      }
    }
    
    }
  }
